@model List<CatalogClientApp.Data.Specialty>
@{
    ViewData["Title"] = "Каталог специальностей по направлениям";
    var number = 0;
}

<h1 class="h3 mb-4">Каталог специальностей по направлениям</h1>

<form asp-action="Index" method="get" class="mb-3">
    <label for="search" class="form-label">Поиск по части слова в любом столбце (без учёта регистра)</label>
    <div class="d-flex flex-wrap gap-2">
        <input id="search" name="search" value="@ViewBag.Search"
               class="form-control w-auto" placeholder="Введите текст" />
        <button type="submit" class="btn btn-primary">Найти</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
    </div>
</form>

<a asp-action="Add" class="btn btn-success mb-3">Добавить специальность</a>

<div class="table-responsive">
    <table class="table table-bordered align-middle">
        <thead>
            <tr>
                <th>№ п/п</th>
                <th>Образовательная программа</th>
                <th>Направление подготовки</th>
                <th>Научная отрасль</th>
                <th>Уровень образования</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@(++number)</td>
                    <td>@item.EducationalProgram</td>
                    <td>@item.FieldOfStudy</td>
                    <td>@item.ScientificField</td>
                    <td>@item.EducationLevel</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary mb-1">Редактировать</a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                              onsubmit="return confirm('Удалить специальность?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="6">Записи не найдены. Добавьте специальность или измените фильтр.</td></tr>
            }
        </tbody>
    </table>
</div>


