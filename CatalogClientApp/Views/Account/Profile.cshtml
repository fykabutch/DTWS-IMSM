@{ ViewData["Title"] = "Личный кабинет"; }
<h1 class="h3">Личный кабинет</h1>
<p>Пользователь: @User.Identity?.Name</p>
<p>Роль: @(User.IsInRole("Admin") ? "Администратор" : "Пользователь")</p>
@if (User.IsInRole("Admin"))
{
    <p>Вы можете добавлять, редактировать и удалять записи каталога.</p>
    <a asp-action="Admin">Страница администратора</a>
}
else
{
    <p>Вы можете просматривать каталог и пользоваться поиском.</p>
}

