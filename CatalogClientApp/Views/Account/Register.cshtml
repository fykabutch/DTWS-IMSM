@model CatalogClientApp.Models.RegisterViewModel
@{ ViewData["Title"] = "Регистрация"; }
<h1 class="h3">Регистрация</h1>
<form asp-action="Register" method="post" class="col-md-7">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Username" class="form-label">Логин</label>
        <input asp-for="Username" class="form-control" autocomplete="username" />
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label">Пароль</label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" />
    </div>
    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label">Повторите пароль</label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
    </div>
    <button class="btn btn-primary">Зарегистрироваться</button>
    <a asp-action="Login" class="btn btn-outline-secondary">Войти</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

