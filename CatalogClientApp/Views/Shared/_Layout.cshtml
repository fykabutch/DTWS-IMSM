<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Каталог специальностей</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar bg-light border-bottom mb-4">
        <div class="container d-flex flex-wrap gap-3">
            <a asp-controller="Specialties" asp-action="Index" class="navbar-brand">Каталог специальностей</a>
            <a asp-controller="Directions" asp-action="Index">Направления</a>
            <a asp-controller="Specialties" asp-action="Index">Специальности</a>
            <a asp-controller="Specializations" asp-action="Index">Специализации</a>
        </div>
    </nav>
    <main class="container pb-4">@RenderBody()</main>
    <footer class="border-top text-muted py-3 mt-auto"><div class="container">Русскин Антон Евгеньевич. НМТМ-163901</div></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

