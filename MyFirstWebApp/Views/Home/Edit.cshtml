@model MyFirstWebApp.Data.Specialty
@{
    ViewData["Title"] = "Редактировать специальность";
}
<h1 class="h3 mb-4">@ViewData["Title"]</h1>

<form asp-action="Edit" method="post" class="col-md-7">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="EducationalProgram" class="form-label"></label>
        <input asp-for="EducationalProgram" class="form-control" />
        <span asp-validation-for="EducationalProgram" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="FieldOfStudy" class="form-label"></label>
        <input asp-for="FieldOfStudy" class="form-control" />
        <span asp-validation-for="FieldOfStudy" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ScientificField" class="form-label"></label>
        <input asp-for="ScientificField" class="form-control" />
        <span asp-validation-for="ScientificField" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="EducationLevel" class="form-label"></label>
        <input asp-for="EducationLevel" class="form-control" />
        <span asp-validation-for="EducationLevel" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


